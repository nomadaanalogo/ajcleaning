---
import Icon from './Icon.astro';
import type { Faq } from '../data/faq';
import type { Lang } from '../data/i18n';
interface Props { lang: Lang; items: Faq[]; title?: string; id?: string }
const { lang, items, title, id } = Astro.props;
---
<section class="faq section" id={id}>
  <div class="wrap grid">
    <div data-up>
      <p class="kicker"><Icon name="star" /> FAQ</p>
      <h2 class="h2">{title ?? (lang === 'es' ? 'Respuestas rápidas' : 'Quick answers')}</h2>
    </div>
    <div class="list">
      {items.map((f) => (
        <details>
          <summary>{f.q[lang]}<Icon name="plus" /></summary>
          <p>{f.a[lang]}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--cream); }
  .grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 72px); }
  h2 { margin-top: 12px; }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 20px; font-weight: 600; font-size: 1.1rem; line-height: 1.3; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { width: 22px; height: 22px; flex: none; color: var(--sea-700); transition: rotate 0.3s var(--ease); }
  details[open] summary :global(svg) { rotate: 45deg; }
  details p { padding-bottom: 20px; color: var(--ink-soft); max-width: 58ch; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
</style>
