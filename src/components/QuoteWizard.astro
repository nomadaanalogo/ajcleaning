---
/**
 * Solicitud de cotización en 3 pasos: propiedad, servicio y datos.
 * Es un formulario real: src/scripts/wizard.ts le pone los pasos y lo envía a la hoja de Drive.
 * No muestra precios: el negocio los envía después de revisar cada solicitud.
 */
import Icon from './Icon.astro';
import { ui, routes, type Lang } from '../data/i18n';
import { whatsappUrl } from '../data/site';
import { areas } from '../data/areas';
import { plans } from '../data/plans';
import type { IconName } from '../data/icons';

interface Props {
  lang: Lang;
  title?: string;
  preset?: { property?: string; service?: string; city?: string };
}
const { lang, title, preset = {} } = Astro.props;
const es = lang === 'es';
const c = ui.common;

const properties: { id: keyof typeof ui.property; icon: IconName }[] = [
  { id: 'house', icon: 'house' },
  { id: 'apartment', icon: 'apartment' },
  { id: 'airbnb', icon: 'key' },
  { id: 'office', icon: 'office' },
  { id: 'listing', icon: 'sign' },
];
const serviceOptions: { id: keyof typeof ui.serviceType; icon: IconName }[] = [
  { id: 'recurring', icon: 'calendar' },
  { id: 'once', icon: 'house' },
  { id: 'deep', icon: 'sparkle' },
  { id: 'move', icon: 'box' },
  { id: 'construction', icon: 'helmet' },
  { id: 'laundry', icon: 'laundry' },
  { id: 'addons', icon: 'window' },
];
const recurringPlans = plans.filter((p) => p.id !== 'once');
const defaultService = preset.service ?? 'recurring';
const totalSteps = 3;
const zona = areas.find((a) => a.id === preset.city)?.name ?? '';

/* La hoja de seguimiento siempre queda en español, sin importar el idioma del visitante. */
const config = {
  endpoint: import.meta.env.PUBLIC_FORM_ENDPOINT ?? '',
  lang,
  zona,
  whatsappBase: whatsappUrl(''),
  sheet: {
    property: Object.fromEntries(properties.map((p) => [p.id, ui.property[p.id].es])),
    service: Object.fromEntries(serviceOptions.map((s) => [s.id, ui.serviceType[s.id].es])),
    frequency: Object.fromEntries(recurringPlans.map((p) => [p.id, ui.frequency[p.id].es])),
  },
  labels: {
    property: Object.fromEntries(properties.map((p) => [p.id, ui.property[p.id][lang]])),
    service: Object.fromEntries(serviceOptions.map((s) => [s.id, ui.serviceType[s.id][lang]])),
    frequency: Object.fromEntries(recurringPlans.map((p) => [p.id, ui.frequency[p.id][lang]])),
  },
  strings: {
    stepOf: es ? 'Paso {n} de {t}' : 'Step {n} of {t}',
    empty: es ? 'Elige una opción' : 'Choose an option',
    send: es ? 'Pedir mi cotización' : 'Request my quote',
    sending: es ? 'Enviando...' : 'Sending...',
    required: es ? 'Falta este dato.' : 'We need this one.',
    badEmail: es ? 'Revisa tu correo.' : 'Check your email.',
    waMsg: es ? '¡Hola AJ Cleaning Home! Quiero una cotización.' : 'Hi AJ Cleaning Home! I would like a quote.',
    wName: es ? 'Nombre' : 'Name',
    wAddress: es ? 'Dirección' : 'Address',
    wProperty: es ? 'Propiedad' : 'Property',
    wService: es ? 'Servicio' : 'Service',
    wFrequency: es ? 'Frecuencia' : 'Frequency',
  },
};
---
<section class="quote" id="quote">
  <div class="wrap head" data-up>
    <p class="kicker"><Icon name="star" /> {es ? 'Cotización gratis. Sin compromiso.' : 'Free quote. No commitment.'}</p>
    <h2 class="h2">{title ?? (es ? 'Tu cotización empieza aquí.' : 'Your quote starts here.')}</h2>
  </div>

  <div class="wrap layout">
    <form class="wizard" data-wizard novalidate>
      <div class="flow" data-flow>
        <div class="progress" aria-hidden="true"><i data-progress style={`transform:scaleX(${1 / totalSteps})`}></i></div>
        <p class="count" data-count aria-live="polite">{config.strings.stepOf.replace('{n}', '1').replace('{t}', String(totalSteps))}</p>

        <!-- 1. Propiedad -->
        <fieldset class="step is-on" data-step="property">
          <legend>{es ? '¿Para qué propiedad es?' : 'What kind of property?'}</legend>
          <div class="cards cards--five">
            {properties.map((p) => (
              <label class="card" data-auto>
                <input type="radio" name="property" value={p.id} checked={preset.property === p.id} required />
                <span class="card-in">
                  <Icon name={p.icon} class="ic" />
                  <b>{ui.property[p.id][lang]}</b>
                  <small>{ui.propertyHint[p.id][lang]}</small>
                </span>
              </label>
            ))}
          </div>
          <p class="err" data-err-group="property" role="alert" hidden>{config.strings.empty}</p>
          <div class="nav nav--card"><button type="button" class="btn btn--primary" data-next>{es ? 'Continuar' : 'Continue'} <Icon name="arrow" /></button></div>
        </fieldset>

        <!-- 2. Servicio: lo recurrente va primero y recomendado -->
        <fieldset class="step" data-step="service">
          <legend>{es ? '¿Qué servicio deseas?' : 'What service do you need?'}</legend>
          <div class="cards cards--services">
            {serviceOptions.map((s) => (
              <label class:list={['card', { 'card--top': s.id === 'recurring' }]} data-auto={s.id !== 'recurring' ? '' : undefined}>
                <input type="radio" name="service" value={s.id} checked={defaultService === s.id} />
                <span class="card-in">
                  {s.id === 'recurring' && <em class="badge"><Icon name="star" /> {es ? 'Recomendado · mejor tarifa por visita' : 'Recommended · best rate per visit'}</em>}
                  <Icon name={s.icon} class="ic" />
                  <b>{ui.serviceType[s.id][lang]}</b>
                  <small>{ui.serviceTypeHint[s.id][lang]}</small>
                </span>
              </label>
            ))}
            <div class="freq" data-freq>
              <p id="freq-label">{es ? '¿Cada cuánto vamos?' : 'How often should we come?'}</p>
              <div class="chips" role="group" aria-labelledby="freq-label">
                {recurringPlans.map((p, i) => (
                  <label class="chip-opt">
                    <input type="radio" name="frequency" value={p.id} checked={i === 0} />
                    <span>{ui.frequency[p.id][lang]}</span>
                  </label>
                ))}
              </div>
              <div class="freq-next"><button type="button" class="btn btn--primary" data-next>{es ? 'Continuar' : 'Continue'} <Icon name="arrow" /></button></div>
            </div>
          </div>
          <div class="nav nav--card"><button type="button" class="btn btn--primary" data-next>{es ? 'Continuar' : 'Continue'} <Icon name="arrow" /></button></div>
        </fieldset>

        <!-- 3. Datos -->
        <fieldset class="step" data-step="contact">
          <legend>{es ? '¿A dónde te enviamos la cotización?' : 'Where should we send your quote?'}</legend>
          <div class="fields">
            <label class="field"><span>{es ? 'Tu nombre' : 'Your name'}</span><input type="text" name="name" autocomplete="name" maxlength="80" required /><small class="err" hidden></small></label>
            <label class="field"><span>{es ? 'Tu correo' : 'Your email'}</span><input type="email" name="email" autocomplete="email" inputmode="email" maxlength="160" required /><small class="err" hidden></small></label>
            <label class="field field--wide"><span>{es ? 'Dirección de la propiedad' : 'Property address'}</span><input type="text" name="address" autocomplete="street-address" maxlength="200" placeholder={es ? 'Calle, ciudad y código postal' : 'Street, city and ZIP'} required /><small class="err" hidden></small></label>
          </div>
          <!-- Campo trampa para bots: las personas no lo ven -->
          <div class="trap" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="nav nav--final">
            <button type="submit" class="btn btn--primary btn--send" data-submit data-track="quote_submit">{config.strings.send} <Icon name="arrow" /></button>
          </div>
          <p class="legal">
            {es ? 'Al enviar, aceptas los ' : 'By sending, you accept our '}
            <a href={routes.terms[lang]}>{es ? 'términos' : 'terms'}</a>
            {es ? ' y la ' : ' and '}
            <a href={routes.privacy[lang]}>{es ? 'política de privacidad' : 'privacy policy'}</a>.
          </p>
          <div class="fail" data-fail role="alert" hidden>
            <p>{es ? 'No pudimos enviar tu solicitud. Tus datos siguen aquí.' : 'We could not send your request. Your details are still here.'}</p>
            <a class="btn btn--wa" data-fail-wa href={whatsappUrl(c.waHello[lang])} target="_blank" rel="noopener"><Icon name="whatsapp" /> {es ? 'Enviar por WhatsApp' : 'Send on WhatsApp'}</a>
          </div>
        </fieldset>

        <button type="button" class="back" data-back hidden><Icon name="back" /> {es ? 'Atrás' : 'Back'}</button>
      </div>

      <!-- Confirmación -->
      <div class="done" data-done tabindex="-1" hidden>
        <span class="done-mark"><Icon name="check" /></span>
        <h3>{es ? <>¡Listo, <span data-done-name></span>!</> : <>You’re all set, <span data-done-name></span>!</>}</h3>
        <p>{es ? 'Recibimos tu solicitud. Te contactaremos pronto con tu cotización.' : 'We got your request. We will contact you soon with your quote.'}</p>
      </div>
      <noscript><p class="tip"><a href={whatsappUrl(c.waHello[lang])}>{c.whatsapp[lang]}</a></p></noscript>
    </form>

    <aside class="side" aria-label={es ? 'Tu solicitud' : 'Your request'}>
      <p class="s-label">{es ? 'Tu solicitud' : 'Your request'}</p>
      <dl class="s-list">
        <div><dt>{es ? 'Propiedad' : 'Property'}</dt><dd data-s-property>—</dd></div>
        <div><dt>{es ? 'Servicio' : 'Service'}</dt><dd data-s-service>{ui.serviceType.recurring[lang]}</dd></div>
        <div data-s-frequency-row><dt>{es ? 'Frecuencia' : 'Frequency'}</dt><dd data-s-frequency>{ui.frequency.weekly[lang]}</dd></div>
      </dl>
      <p class="s-label s-next">{es ? 'Qué sigue' : 'What’s next'}</p>
      <ol class="s-steps">
        <li>{es ? 'Revisamos tu solicitud.' : 'We review your request.'}</li>
        <li>{es ? 'Te enviamos tu cotización.' : 'We send your quote.'}</li>
        <li>{es ? 'Apartas tu cupo con el 25%.' : 'You hold your spot with 25%.'}</li>
      </ol>
    </aside>
  </div>
  <script type="application/json" data-wizard-config set:html={JSON.stringify(config)}></script>
</section>

<script>
  import '../scripts/wizard';
</script>

<style>
  .quote { position: relative; background: var(--sea-100); padding-block: clamp(64px, 9vw, 112px); }
  .head { margin-bottom: clamp(28px, 4vw, 48px); }
  .head h2 { margin-top: 12px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(20px, 3vw, 36px); align-items: start; }

  .wizard { position: relative; background: var(--cream); border-radius: 30px; padding: clamp(22px, 3.4vw, 44px); box-shadow: 0 34px 70px -44px rgb(19 74 77 / 0.55); }
  .progress { height: 6px; border-radius: 9px; background: var(--sea-100); overflow: hidden; }
  .progress i { display: block; height: 100%; background: var(--sea-700); transform-origin: left; transition: transform 0.5s var(--ease); }
  .count { margin: 12px 0 18px; font-size: 0.9rem; font-weight: 600; color: var(--ink-soft); }

  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: 20px; font-family: var(--display); font-weight: 600; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1; letter-spacing: -0.01em; }
  legend:focus { outline: 0; }
  /* Sin JS se ven todos los pasos; con JS, uno a la vez */
  .step + .step { margin-top: 36px; }
  :global(.js) .step { display: none; margin-top: 0; }
  :global(.js) .step.is-on { display: block; animation: stepIn 0.5s var(--ease); }
  @keyframes stepIn { from { opacity: 0; transform: translateX(24px); } }

  input[type='radio'] { position: absolute; opacity: 0; width: 1px; height: 1px; }

  .cards { display: grid; gap: 12px; }
  .cards--five { grid-template-columns: repeat(6, 1fr); }
  .cards--five .card { grid-column: span 2; }
  .cards--five .card:nth-child(n + 4) { grid-column: span 3; }
  .cards--services { grid-template-columns: repeat(3, 1fr); }
  .card { position: relative; cursor: pointer; }
  .card-in { display: grid; gap: 4px; align-content: start; height: 100%; padding: 18px; background: #fff; border: 1.5px solid var(--line); border-radius: 20px; transition: transform 0.25s var(--ease), border-color 0.2s, background 0.2s, box-shadow 0.2s; }
  .card-in b { font-size: 1.1rem; font-weight: 600; line-height: 1.2; }
  .card-in small { color: var(--ink-soft); font-size: 0.93rem; line-height: 1.3; }
  .card-in :global(.ic) { width: 32px; height: 32px; margin-bottom: 8px; color: var(--sea-700); }
  .card:hover .card-in { transform: translateY(-3px); border-color: var(--sea-700); box-shadow: 0 16px 28px -22px rgb(19 74 77 / 0.7); }
  .card input:checked + .card-in { background: var(--sea-100); border-color: var(--sea-700); box-shadow: inset 0 0 0 1.5px var(--sea-700); }
  input:focus-visible + .card-in, input:focus-visible + span { outline: 3px solid var(--sea-700); outline-offset: 2px; }
  .card--top { grid-column: 1 / -1; }
  .card--top .card-in { padding: 22px; background: var(--sea-50); }
  .card--top b { font-size: 1.35rem; }
  .badge { justify-self: start; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 10px; padding: 5px 12px; background: var(--sea-700); color: #fff; border-radius: 99px; font-style: normal; font-size: 0.82rem; font-weight: 600; line-height: 1.2; }
  .badge :global(.star) { width: 11px; height: 11px; fill: #f2d49c; flex: none; }

  .cards--services .card { order: 3; }
  .cards--services .card--top { order: 1; }
  .freq { order: 2; grid-column: 1 / -1; padding: 16px 18px; background: var(--sea-50); border-radius: 18px; }
  .freq-next { display: flex; justify-content: flex-end; margin-top: 14px; }
  /* Con "recurrente" el botón va junto a la frecuencia */
  .step:has(input[value='recurring']:checked) .nav--card { display: none; }
  .freq[hidden] { display: none; }
  .freq p { font-weight: 600; margin-bottom: 10px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip-opt { position: relative; cursor: pointer; }
  .chip-opt span { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; background: #fff; border: 1.5px solid var(--line); border-radius: 999px; font-weight: 600; transition: border-color 0.2s, background 0.2s, color 0.2s; }
  .chip-opt:hover span { border-color: var(--sea-700); }
  .chip-opt input:checked + span { background: var(--sea-700); border-color: var(--sea-700); color: #fff; }

  .nav { display: flex; justify-content: flex-end; margin-top: 24px; }
  .nav--card { display: none; }
  .step:has(input:checked) .nav--card { display: flex; }
  .tip { margin-top: 14px; font-size: 0.95rem; color: var(--ink-soft); }

  .fields { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .field { display: grid; gap: 6px; align-content: start; font-weight: 600; font-size: 0.95rem; }
  .field--wide { grid-column: 1 / -1; }
  .field input { width: 100%; min-height: 54px; padding: 12px 16px; background: #fff; border: 1.5px solid var(--line); border-radius: 14px; font-weight: 400; font-size: 1rem; }
  .field input:focus { outline: 0; border-color: var(--sea-700); box-shadow: 0 0 0 3px var(--sea-200); }
  .field.is-bad input { border-color: #b4412d; }
  .err { color: #a23a27; font-weight: 600; font-size: 0.9rem; }
  p.err { margin-top: 10px; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .btn--send { width: 100%; min-height: 60px; font-size: 1.08rem; }
  .btn--send[disabled] { opacity: 0.7; cursor: progress; transform: none; }
  .nav--final { margin-top: 20px; }
  .legal { margin-top: 12px; font-size: 0.88rem; color: var(--ink-soft); }
  .fail { margin-top: 14px; padding: 14px 16px; background: #fff1e6; border-radius: 14px; display: grid; gap: 10px; font-weight: 600; }
  .fail[hidden] { display: none; }
  .fail .btn { justify-self: start; min-height: 46px; padding-block: 8px; }

  .back { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; min-height: 44px; padding: 8px 4px; background: none; border: 0; font-weight: 600; color: var(--ink-soft); cursor: pointer; }
  .back:hover { color: var(--ink); }
  .back :global(svg) { width: 18px; height: 18px; }
  .back[hidden] { display: none; }

  .done { display: grid; justify-items: start; gap: 12px; padding-block: 24px; }
  .done:focus { outline: 0; }
  .done[hidden] { display: none; }
  .done-mark { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--sea-700); color: #fff; }
  .done-mark :global(svg) { width: 34px; height: 34px; stroke-width: 2.2; }
  .done h3 { font-family: var(--display); font-size: clamp(2.2rem, 4vw, 3.2rem); line-height: 1; }
  .done p { font-size: 1.1rem; color: var(--ink-soft); max-width: 40ch; }
  .flow[hidden] { display: none; }

  .side { position: sticky; top: 92px; padding: 26px; background: var(--sea-900); color: #f2f9f7; border-radius: 26px; box-shadow: 0 30px 60px -36px rgb(15 58 61 / 0.9); }
  .s-label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sea-200); }
  .s-next { margin-top: 22px; padding-top: 18px; border-top: 1px solid rgb(255 255 255 / 0.16); }
  .s-list { margin: 12px 0 0; display: grid; gap: 10px; }
  .s-list dt { font-size: 0.86rem; color: var(--sea-200); }
  .s-list dd { margin: 0; font-family: var(--display); font-weight: 600; font-size: 1.5rem; line-height: 1.1; }
  .s-steps { margin-top: 12px; display: grid; gap: 8px; counter-reset: s; }
  .s-steps li { display: flex; gap: 10px; align-items: baseline; counter-increment: s; line-height: 1.3; }
  .s-steps li::before { content: counter(s); flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #f2d49c; color: var(--ink); font-size: 0.82rem; font-weight: 700; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 620px) {
    .cards--five, .cards--services { grid-template-columns: repeat(2, 1fr); }
    .cards--five .card, .cards--five .card:nth-child(n + 4) { grid-column: auto; }
    .cards--five .card:last-child { grid-column: 1 / -1; }
    .card-in { padding: 15px; }
    .fields { grid-template-columns: 1fr; }
    .chip-opt span { padding-inline: 14px; }
  }
</style>
