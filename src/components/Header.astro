---
import Icon from './Icon.astro';
import { ui, routes, quoteHref, type Lang } from '../data/i18n';
interface Props { lang: Lang; alt: string; overlay?: boolean }
const { lang, alt, overlay = false } = Astro.props;
const n = ui.nav;
const links = [
  { href: routes.services[lang], label: n.services[lang] },
  { href: routes.areas[lang], label: n.areas[lang] },
  { href: `${routes.home[lang]}#faq`, label: n.faq[lang] },
];
const altLang = lang === 'en' ? 'es' : 'en';
---
<header class:list={['site-header', { 'is-overlay': overlay }]} data-header>
  <div class="bar">
    <a class="brand" href={routes.home[lang]} aria-label={`AJ Cleaning Home, ${n.home[lang]}`}>
      <img src="/brand/logo-160.webp" alt="" width="52" height="52" />
      <span>AJ Cleaning Home</span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="lang" href={alt} hreflang={altLang} lang={altLang} aria-label={n.langLabel[lang]}>
        <span class="lang-long">{n.langName[lang]}</span><span class="lang-short">{n.langShort[lang]}</span>
      </a>
      <a class="btn btn--primary cta" href={quoteHref(lang)} data-track="cta_click">{n.quote[lang]}</a>
      <details class="menu">
        <summary aria-label={n.menu[lang]}><Icon name="menu" /></summary>
        <nav aria-label="Mobile">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const update = () => header?.classList.toggle('is-solid', window.scrollY > 40);
  update();
  window.addEventListener('scroll', update, { passive: true });
  // Cierra el menú móvil al tocar un enlace.
  document.querySelectorAll<HTMLAnchorElement>('.menu nav a').forEach((a) => {
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
  });
</script>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; padding: 12px var(--gutter); transition: background 0.3s, box-shadow 0.3s, padding 0.3s; background: rgb(251 246 239 / 0.92); backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--line); }
  .site-header.is-overlay { background: transparent; backdrop-filter: none; box-shadow: none; }
  .site-header.is-solid { background: rgb(251 246 239 / 0.92); backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--line); padding-block: 8px; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; max-width: 1320px; margin-inline: auto; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--display); font-weight: 600; font-size: 1.3rem; white-space: nowrap; }
  .brand img { width: 52px; height: 52px; border-radius: 50%; }
  .links { display: flex; gap: clamp(16px, 2.2vw, 30px); }
  .links a { font-weight: 500; text-decoration: none; padding: 6px 2px; background: linear-gradient(var(--sea-700), var(--sea-700)) left bottom / 0 2px no-repeat; transition: background-size 0.3s var(--ease); }
  .links a:hover { background-size: 100% 2px; }
  .actions { display: flex; align-items: center; gap: 10px; }
  .lang { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 14px; border: 1.5px solid rgb(60 36 21 / 0.28); border-radius: 999px; font-size: 0.92rem; font-weight: 600; text-decoration: none; transition: background 0.2s, color 0.2s; }
  .is-overlay:not(.is-solid) .lang { background: rgb(251 246 239 / 0.9); }
  .lang:hover, .is-overlay:not(.is-solid) .lang:hover { background: var(--ink); color: #fff; }
  .lang-short { display: none; }
  .cta { min-height: 44px; padding: 8px 20px; font-size: 0.95rem; white-space: nowrap; }
  .menu { display: none; position: relative; }
  .menu summary { display: grid; place-items: center; width: 44px; height: 44px; cursor: pointer; list-style: none; border-radius: 50%; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary :global(svg) { width: 26px; height: 26px; }
  .menu nav { position: absolute; right: 0; top: 52px; display: grid; min-width: 210px; padding: 8px; background: var(--cream); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 50px -24px rgb(60 36 21 / 0.45); }
  .menu nav a { padding: 12px 14px; font-weight: 600; text-decoration: none; border-radius: 10px; }
  .menu nav a:hover { background: var(--sea-100); }
  @media (max-width: 980px) {
    .links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 620px) {
    .brand span, .lang-long { display: none; }
    .lang-short { display: inline; }
    .brand img { width: 46px; height: 46px; }
    .actions { gap: 6px; }
    .lang { padding-inline: 12px; }
    .cta { padding-inline: 16px; }
  }
</style>
