---
interface Props { items: { name: string; href?: string }[]; label: string }
const { items, label } = Astro.props;
---
<nav aria-label={label}>
  <ol class="crumbs">
    {items.map((it) => <li>{it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>)}
  </ol>
</nav>
