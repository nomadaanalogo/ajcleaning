---
import { icons, whatsappPath, type IconName } from '../data/icons';
interface Props { name: IconName | 'whatsapp' | 'star'; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'whatsapp' ? (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={whatsappPath} /></svg>
) : name === 'star' ? (
  <svg class:list={['star', cls]} viewBox="-12 -12 24 24" aria-hidden="true"><path d="M0-12C1.500-3 3-1.500 12 0 3 1.500 1.500 3 0 12-1.500 3-3 1.500-12 0-3-1.500-1.500-3 0-12Z" /></svg>
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[name]} /></svg>
)}
