---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { heroPhoto } from '../../lib/photos';
import { quoteHref, type Lang } from '../../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
---
<section class="hero-track" data-hero-track>
  <div class="hero" data-hero>
    <div class="stage" data-stage>
      <Image class="photo" src={heroPhoto.src} alt={heroPhoto.alt[lang]} widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />
      <div class="sun" aria-hidden="true"></div>
      <div class="glints" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /></div>
    </div>
    <div class="scrim" aria-hidden="true"></div>
    <canvas class="grime" data-grime aria-hidden="true"></canvas>
    <div class="dissolve" data-dissolve aria-hidden="true"></div>

    <div class="wrap copy" data-copy>
      <h1>
        <span class="seo-line">{es ? 'Limpieza de casas recurrente en Miami y Fort Lauderdale' : 'Recurring house cleaning in Miami & Fort Lauderdale'}</span>
        <span class="big">{es ? <>Vuelve a<br />una casa<br /><em>limpia.</em></> : <>Come home<br />to <em>clean.</em></>}</span>
      </h1>
      <p class="sub" data-sub data-done={es ? 'Ahora imagínala así. Cada semana.' : 'Now picture this. Every week.'}>
        {es ? 'Cada semana. Impecable. Sin que muevas un dedo.' : 'Every week. Spotless. Without lifting a finger.'}
      </p>
      <div class="ctas">
        <a class="btn btn--primary" href={quoteHref(lang)} data-track="cta_click">{es ? 'Pide tu cotización gratis' : 'Get your free quote'} <Icon name="arrow" /></a>
      </div>
    </div>

    <div class="game" data-game aria-hidden="true">
      <span class="hint"><Icon name="hand" /><span class="hint-m">{es ? 'Desliza para limpiar' : 'Swipe to clean'}</span><span class="hint-d">{es ? 'Pasa el cursor para limpiar' : 'Move your cursor to clean'}</span></span>
      <span class="meter"><i data-meter></i></span>
      <span class="pct"><b data-pct>0</b>% {es ? 'limpio' : 'clean'}</span>
    </div>

    <div class="cloth" data-cloth aria-hidden="true"><Icon name="star" /></div>
    <canvas class="sparks" data-sparks aria-hidden="true"></canvas>
  </div>
</section>

<script>
  import '../../scripts/hero';
</script>

<style>
  .hero-track { position: relative; height: 100svh; }
  :global(.js) .hero-track { height: 175svh; }
  @media (prefers-reduced-motion: reduce) { :global(.js) .hero-track { height: 100svh; } }

  .hero { position: sticky; top: 0; height: 100svh; min-height: 600px; overflow: hidden; background: #fbf5eb; isolation: isolate; touch-action: pan-y; }
  .stage { position: absolute; inset: 0; z-index: -3; transform-origin: 78% 46%; will-change: transform; }

  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 100% 70%; }
  /* Al terminar de limpiar, entra el sol */
  .sun { position: absolute; inset: 0; background: radial-gradient(70% 90% at 82% 62%, rgb(255 240 200 / 0.5), rgb(255 240 200 / 0) 70%); opacity: 0; transition: opacity 1.6s var(--ease); pointer-events: none; }
  :global(.is-clean) .sun { opacity: 1; }
  .glints :global(.star) { position: absolute; fill: #fff; opacity: 0; filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.9)); }
  .glints :global(.star:nth-child(1)) { left: 84%; top: 34%; width: 46px; height: 46px; }
  .glints :global(.star:nth-child(2)) { left: 62%; top: 80%; width: 30px; height: 30px; }
  .glints :global(.star:nth-child(3)) { left: 90%; top: 84%; width: 38px; height: 38px; }
  :global(.is-clean) .glints :global(.star) { animation: glint 3.2s ease-in-out infinite; }
  :global(.is-clean) .glints :global(.star:nth-child(2)) { animation-delay: 1s; }
  :global(.is-clean) .glints :global(.star:nth-child(3)) { animation-delay: 2s; }
  @keyframes glint { 0%, 100% { opacity: 0; transform: scale(0.6); } 50% { opacity: 1; transform: scale(1); } }

  /* Velo del color de la pared: el texto siempre se lee, aun en pantallas angostas */
  .scrim { position: absolute; inset: 0; z-index: -3; background: linear-gradient(180deg, rgb(251 245 235 / 0.82) 0, rgb(251 245 235 / 0) 110px), linear-gradient(90deg, rgb(251 245 235 / 0.97) 0%, rgb(251 245 235 / 0.93) 42%, rgb(251 245 235 / 0) 66%); pointer-events: none; }

  /* Polvo: mismo tono antes de pintar, para que no se vea un destello limpio. */
  .grime { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; opacity: 1; transition: opacity 1.1s var(--ease); pointer-events: none; }
  :global(.js) .grime:not(.is-ready) { background: #c6b9a8; }
  :global(html:not(.js)) .grime { display: none; }
  .is-clean .grime, :global(.is-clean) .grime { opacity: 0; }

  /* Paso a la siguiente sección: la cámara entra por la ventana hacia el color mar. */
  .dissolve { position: absolute; inset: 0; z-index: 3; background: var(--sea-100); opacity: 0; pointer-events: none; }

  .copy { position: relative; display: flex; flex-direction: column; justify-content: center; height: 100%; padding-block: 92px 92px; }
  h1 { font-weight: 600; }
  .seo-line { display: block; max-width: 34ch; font-family: var(--body); font-size: clamp(0.92rem, 1.25vw, 1.08rem); font-weight: 600; letter-spacing: 0.01em; line-height: 1.35; margin-bottom: 18px; color: var(--sea-800); }
  .big { display: block; font-family: var(--display); font-size: clamp(3.9rem, 9.2vw, 8.6rem); line-height: 0.9; letter-spacing: -0.022em; }
  .big em { font-style: italic; color: var(--sea-700); }
  .sub { max-width: 30ch; margin-top: 22px; font-size: clamp(1.1rem, 1.7vw, 1.4rem); font-weight: 500; line-height: 1.3; transition: opacity 0.35s; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 26px; }

  .game { position: absolute; left: 50%; bottom: max(22px, env(safe-area-inset-bottom)); translate: -50% 0; z-index: 4; display: flex; align-items: center; gap: 14px; padding: 9px 18px; background: rgb(255 253 248 / 0.88); border-radius: 999px; box-shadow: 0 14px 34px -16px rgb(60 36 21 / 0.55); font-size: 0.92rem; font-weight: 600; white-space: nowrap; transition: opacity 0.5s, translate 0.5s var(--ease); pointer-events: none; }
  :global(html:not(.js)) .game { display: none; }
  .hint { display: inline-flex; align-items: center; gap: 8px; }
  .hint :global(svg) { width: 21px; height: 21px; color: var(--sea-700); animation: wave 1.8s var(--ease) infinite; }
  @keyframes wave { 50% { transform: translateX(6px) rotate(9deg); } }
  .hint-d { display: none; }
  @media (hover: hover) and (pointer: fine) { .hint-d { display: inline; } .hint-m { display: none; } }
  .meter { position: relative; width: clamp(60px, 11vw, 140px); height: 7px; background: var(--sand); border-radius: 9px; overflow: hidden; }
  .meter i { position: absolute; inset: 0; background: linear-gradient(90deg, var(--sea-300), var(--sea-700)); transform-origin: left; transform: scaleX(0); }
  .pct b { font-variant-numeric: tabular-nums; }
  :global(.is-clean) .game { opacity: 0; translate: -50% 14px; }

  .cloth { position: absolute; left: 0; top: 0; z-index: 5; width: 74px; height: 74px; margin: -37px 0 0 -37px; display: grid; place-items: center; border-radius: 28% 62% 34% 58%; background: radial-gradient(circle at 34% 28%, #fff, var(--sea-200) 62%, var(--sea-300)); box-shadow: 0 12px 24px -10px rgb(19 74 77 / 0.6); pointer-events: none; opacity: 0; transition: opacity 0.3s; will-change: transform; }
  .cloth :global(.star) { width: 24px; height: 24px; fill: #fff; }
  .cloth.is-on { opacity: 1; }
  :global(.is-clean) .cloth { opacity: 0 !important; }

  .sparks { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .grime, .game, .cloth, .sparks { display: none; }
  }

  @media (max-width: 760px) {
    .stage { top: 51%; transform-origin: 66% 30%; }
    .photo { object-position: 100% 60%; }
    .stage::before { content: ''; position: absolute; inset: -1px 0 auto; height: 22%; z-index: 1; background: linear-gradient(#fbf5eb, transparent); }
    .copy { justify-content: flex-start; padding-block: 96px 0; }
    .big { font-size: clamp(3.4rem, 16.5vw, 5.2rem); }
    .seo-line { margin-bottom: 12px; }
    .sub { margin-top: 12px; }
    .ctas { margin-top: 16px; gap: 10px 14px; }
    .ctas .btn { min-height: 50px; padding-inline: 20px; font-size: 0.98rem; }
    .scrim { display: none; }
    .game { left: 14px; translate: 0 0; max-width: calc(100% - 92px); gap: 8px; padding: 7px 12px; font-size: 0.82rem; }
    :global(.is-clean) .game { translate: 0 14px; }
    .meter { width: 34px; flex: none; }
  }
  @media (max-width: 760px) and (max-height: 700px) { .stage { top: 58%; } }
</style>
