---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import PlanBand from '../components/PlanBand.astro';
import Faq from '../components/Faq.astro';
import { areaById, areaUrl, type Area } from '../data/areas';
import { services, serviceUrl } from '../data/services';
import { faqSchema, type Faq as FaqItem } from '../data/faq';
import { breadcrumbs, serviceSchema } from '../lib/schema';
import { ui, routes, type Lang } from '../data/i18n';
interface Props { lang: Lang; area: Area }
const { lang, area: a } = Astro.props;
const es = lang === 'es';
const other: Lang = es ? 'en' : 'es';
const url = areaUrl(a, lang);
const crumbs = [
  { name: ui.nav.home[lang], href: routes.home[lang] },
  { name: ui.nav.areas[lang], href: routes.areas[lang] },
  { name: a.name, href: url },
];
const faq: FaqItem[] = [
  {
    q: { en: `How much is house cleaning in ${a.name}?`, es: `¿Cuánto cuesta limpiar una casa en ${a.name}?` },
    a: {
      en: 'It depends on the property, the service and how often we come. Request your free quote and we send you the price.',
      es: 'Depende de la propiedad, el servicio y la frecuencia. Pide tu cotización gratis y te enviamos el precio.',
    },
  },
  {
    q: { en: `Do you clean offices and rentals in ${a.name}?`, es: `¿Limpian oficinas y rentas en ${a.name}?` },
    a: {
      en: 'Yes. Homes, apartments, Airbnbs, offices and listings. Tell us what you need.',
      es: 'Sí. Casas, apartamentos, Airbnb, oficinas y propiedades en venta. Cuéntanos qué necesitas.',
    },
  },
  {
    q: { en: 'How do I book?', es: '¿Cómo reservo?' },
    a: {
      en: 'Request your quote here. A 25% deposit before the service day holds your spot. Zelle or transfer.',
      es: 'Pide tu cotización aquí. El 25% antes del día del servicio aparta tu cupo. Zelle o transferencia.',
    },
  },
];
const featured = services.filter((s) => ['recurring', 'deep', 'move', 'airbnb', 'office', 'realtor'].includes(s.id));
---
<Base
  lang={lang}
  alt={areaUrl(a, other)}
  title={es ? `Limpieza de casas en ${a.name}, FL | AJ Cleaning Home` : `House Cleaning in ${a.name}, FL | AJ Cleaning Home`}
  description={es
    ? `Limpieza de casas, Airbnb y oficinas en ${a.name}, Florida. Planes semanales y quincenales. Pide tu cotización gratis.`
    : `House, Airbnb and office cleaning in ${a.name}, Florida. Weekly and biweekly plans. Get your free quote.`}
  jsonLd={[
    breadcrumbs(Astro.site, crumbs),
    serviceSchema(Astro.site, { name: es ? `Limpieza de casas en ${a.name}` : `House cleaning in ${a.name}`, description: a.intro[lang], href: url, areaServed: [`${a.name}, FL`] }),
    faqSchema(faq, lang),
  ]}
>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs label="Breadcrumb" items={[{ name: crumbs[0].name, href: crumbs[0].href }, { name: crumbs[1].name, href: crumbs[1].href }, { name: a.name }]} />
      <h1>{es ? `Limpieza de casas en ${a.name}` : `House cleaning in ${a.name}`}</h1>
      <p class="lead">{a.intro[lang]}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="#quote" data-track="cta_click">{ui.common.getQuote[lang]} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section notes">
    <div class="wrap">
      <h2 class="h2">{es ? `Lo que limpiamos en ${a.name}` : `What we clean in ${a.name}`}</h2>
      <ul>
        {a.notes.map((n) => <li data-up><Icon name="pin" /> {n[lang]}</li>)}
      </ul>
    </div>
  </section>

  <QuoteWizard lang={lang} preset={{ city: a.id }} title={es ? `Tu cotización en ${a.name}` : `Your quote in ${a.name}`} />

  <div class="wrap"><PlanBand lang={lang} /></div>

  <section class="services">
    <div class="wrap">
      <h2 class="h2">{es ? `Servicios en ${a.name}` : `Services in ${a.name}`}</h2>
      <ul class="link-grid">
        {featured.map((s) => <li><a class="link-card" href={serviceUrl(s, lang)}>{s.name[lang]} <Icon name="arrow" /></a></li>)}
      </ul>
    </div>
  </section>

  <Faq lang={lang} items={faq} />

  <section class="section near">
    <div class="wrap">
      <h2 class="h2">{es ? 'También cerca' : 'Also nearby'}</h2>
      <ul class="link-grid">
        {a.nearby.map((id) => { const n = areaById(id); return <li><a class="link-card" href={areaUrl(n, lang)}>{n.name} <Icon name="arrow" /></a></li>; })}
      </ul>
    </div>
  </section>
</Base>

<style>
  .notes ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 28px; }
  .notes li { display: flex; gap: 12px; align-items: center; padding: 22px; background: var(--sea-50); border-radius: 20px; font-weight: 600; font-size: 1.08rem; line-height: 1.3; }
  .notes li :global(svg) { width: 26px; height: 26px; flex: none; color: var(--sea-700); }
  .services { padding-bottom: clamp(48px, 7vw, 88px); }
  .services h2, .near h2 { margin-bottom: 22px; font-size: clamp(2rem, 4vw, 3.2rem); }
  .near { background: var(--cream-2); }
  @media (max-width: 760px) { .notes ul { grid-template-columns: 1fr; } }
</style>
